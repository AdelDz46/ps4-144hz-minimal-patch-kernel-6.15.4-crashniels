+static bool ps4_bridge_is_1080p144(const struct drm_display_mode *mode)
+{
+	if (mode->hdisplay == 1920 && mode->vdisplay == 1080 &&
+	    mode->clock == 333210 &&
+	    mode->hsync_start == 1928 && mode->hsync_end == 1960 && mode->htotal == 2000 &&
+	    mode->vsync_start == 1095 && mode->vsync_end == 1103 && mode->vtotal == 1157 &&
+	    (mode->flags & DRM_MODE_FLAG_PHSYNC) &&
+	    (mode->flags & DRM_MODE_FLAG_NVSYNC))
+		return true;
+	return false;
+}
