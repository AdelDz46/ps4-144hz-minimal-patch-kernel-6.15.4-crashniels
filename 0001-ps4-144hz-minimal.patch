 	mn_bridge->mode = drm_match_cea_mode(adjusted_mode);
-	DRM_DEBUG_KMS("vic mode: %d\n", mn_bridge->mode);
-	if (!mn_bridge->mode) {
+	mn_bridge->custom_mode_valid = false;
+	if (!mn_bridge->mode && ps4_bridge_is_1080p144(adjusted_mode)) {
+		mn_bridge->custom_mode_valid = true;
+		mn_bridge->mode = 63;
+	} else if (!mn_bridge->mode) {
 		DRM_ERROR("attempted to set non-CEA mode\n");
 	}
+	DRM_DEBUG_KMS("vic mode: %d\n", mn_bridge->mode);
 }
 
